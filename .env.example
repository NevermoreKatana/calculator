# Pooled/runtime connection used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Direct (unpooled) connection used by `prisma migrate` / `prisma db push`.
# With Neon / Supabase / Vercel Postgres this is the NON-pooled URL.
# Locally it can be identical to DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Optional: external ingredient lookup (Open Food Facts). Defaults shown.
OPEN_FOOD_FACTS_BASE_URL="https://world.openfoodfacts.org"
EXTERNAL_LOOKUP_TIMEOUT_MS="6000"
